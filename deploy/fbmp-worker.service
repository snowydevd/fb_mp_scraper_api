# Una corrida del pipeline. La dispara fbmp-worker.timer.
#
# Type=oneshot y no un proceso de larga vida: si una corrida se cuelga o se
# muere, systemd la limpia y la próxima arranca igual. Un `npm run
# worker:schedule` corriendo para siempre acumula estado y se cae en silencio.
[Unit]
Description=fb_mp_scraper — una corrida del pipeline de oportunidades
Documentation=https://github.com/snowydevd/fb_mp_scraper_api
# No tiene sentido arrancar sin red.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Projects/fb_mp_scraper_api
ExecStart=/usr/bin/npm run worker

# Una corrida real tarda ~40s. Si pasa de 15 minutos algo se colgó: matarla y
# esperar al próximo disparo es mejor que dejarla ahí.
TimeoutStartSec=15min

# El scrapeo falla seguido y es normal (sesión vencida, captcha, Facebook
# cambió un selector). No reintentar: el próximo disparo del timer ya es el
# reintento, y con su delay aleatorio encima.
Restart=no

# Endurecimiento. El worker sólo necesita leer el proyecto y escribir la sesión.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Documents/Projects/fb_mp_scraper_api
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
