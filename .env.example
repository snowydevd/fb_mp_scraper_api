# Copiá esto a `.env` (está en .gitignore) y completá lo que uses.
# config.mjs carga el .env solo, no hace falta exportar nada a mano.

# --- Base de datos ---------------------------------------------------------
# Supabase: Dashboard -> Connect -> "Session pooler" (puerto 5432).
#
# Usá el SESSION POOLER, no la conexión directa: desde 2024 la directa
# (db.<ref>.supabase.co) es sólo IPv6, y si tu ISP no tiene IPv6 falla con
# ENETUNREACH. El session pooler es IPv4 y soporta todo, incluido el bloque
# multi-sentencia de `npm run migrate`.
#
# El transaction pooler (puerto 6543) también sirve para el worker, pero no
# para migrate.
#
# Si tu password tiene @ : / o ? hay que URL-encodearlo (@ -> %40).
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# --- Sesión de Facebook (opcional, recomendado) ----------------------------
# Sin sesión funciona desde una IP residencial de Uruguay. Una de las dos:
# FB_COOKIES="c_user=1000123...; xs=abc..."
# FB_STORAGE_STATE=./fb-state.json
# FB_STORAGE_STATE_OUT=./fb-state.json

# --- Worker programado (opcional, ya tienen defaults sanos) -----------------
# WORKER_INTERVAL_HOURS=6
# WORKER_ACTIVE_HOURS=9-22
# TARGET_MIN_PRICE=5000
# TARGET_MAX_PRICE=12000
# DETAIL_MAX_PER_RUN=5
# DETAIL_SCORE_THRESHOLD=0

# --- Tipo de cambio (opcional) ---------------------------------------------
# Sólo se usa para sumar una deuda declarada en una moneda distinta a la del
# precio. Sin esto no se convierte nada: el monto queda reportado en
# facts.debtNeedsReview para que lo mires vos.
# UYU_PER_USD=40
