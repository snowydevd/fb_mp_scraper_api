{
  "name": "fb_mp_scrapper_api",
  "version": "1.0.0",
  "main": "src/main.mjs",
  "type": "module",
  "scripts": {
    "start": "node src/main.mjs",
    "dev": "npx nodemon src/main.mjs",
    "worker": "node src/worker/sync.mjs",
    "worker:dry": "node src/worker/sync.mjs --dry",
    "migrate": "node -e \"import('./src/db/repo.mjs').then(m=>m.migrate().then(()=>{console.log('schema aplicado');process.exit(0)}))\"",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "worker:schedule": "node src/worker/scheduler.mjs",
    "worker:schedule:dry": "node src/worker/scheduler.mjs --dry",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "db:up": "docker run -d --name fbmp-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=fbmp -p 55432:5432 postgres:16-alpine",
    "db:down": "docker rm -f fbmp-pg",
    "meli:check": "node scripts/meli-check.mjs",
    "compare": "node scripts/compare-sources.mjs",
    "meli:diagnose": "node scripts/meli-diagnose.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "playwright": "^1.55.0"
  }
}
